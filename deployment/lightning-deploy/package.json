{
  "name": "swarm-platform",
  "version": "1.0.0",
  "description": "Multi-Agent AI Orchestration Platform — Enterprise-grade, $0 infrastructure",
  "private": true,
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "vinext deploy",
    "deploy:preview": "vinext deploy --preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:db": "jest --testPathPattern=database",
    "test:coverage": "jest --coverage",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "analyze": "vinext analyze"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/redis": "^1.28.0",
    "next-auth": "^4.24.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ai": "^3.0.0",
    "@ai-sdk/anthropic": "^0.0.20",
    "@ai-sdk/google": "^0.0.20",
    "groq-sdk": "^0.3.0",
    "zod": "^3.22.0",
    "nats": "^2.19.0",
    "ioredis": "^5.3.0"
  },
  "devDependencies": {
    "vinext": "^0.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "prisma": "^5.10.0",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@playwright/test": "^1.41.0",
    "tsx": "^4.7.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.1.0",
    "@types/jest": "^29.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
